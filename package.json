{
  "name": "@pubid/pubid",
  "version": "0.1.4",
  "description": "TypeScript PubID identifiers: resolution, normalization and canonical hashes for every identifier in the pubid-testsuite corpus (41 standards bodies), with a conformance runner mirroring the Ruby reference",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "conformance": "tsc -p tsconfig.json && node dist/conformance/cli.js",
    "prepublishOnly": "tsc -p tsconfig.json",
    "artifact": "tsc -p tsconfig.json && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  },
  "files": [
    "dist",
    "artifact"
  ],
  "keywords": [
    "pubid",
    "identifier",
    "standards",
    "iso",
    "iec",
    "ieee",
    "nist",
    "conformance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubid/pubid-ts.git"
  },
  "homepage": "https://github.com/pubid/pubid-ts#readme",
  "bugs": {
    "url": "https://github.com/pubid/pubid-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
