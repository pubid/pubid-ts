{
  "name": "pubid-ts",
  "version": "0.1.0",
  "description": "TypeScript implementation of PubID identifiers, conforming to the pubid-testsuite corpus",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "conformance": "tsc -p tsconfig.json && node dist/conformance/cli.js"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}