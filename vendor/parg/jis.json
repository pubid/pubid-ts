ess":null},{"capture":"corr_number","path":"corr_number","type":"string","card":null,"preprocess":null},{"capture":"corr_year","path":"corr_year","type":"string","card":null,"preprocess":null},{"capture":"corr_reaffirmed","path":"corr_reaffirmed","type":"string","card":null,"preprocess":null},{"capture":"symbol_present","path":"symbol_present","type":"string","card":null,"preprocess":null},{"capture":"symbol_value","path":"symbol_value","type":"string","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule supplement: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule symbol_value_char: branches 1 and 2 are order-dependent (first set not statically known)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"JIS B 0001","expect":{}},{"entry":"identifier","kind":"accept","input":"JIS X 0208:1997","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/jis/parser.rb — JIS identifiers with the Japanese\n# full-width separator tolerance (ｰ 　 ： （）), TR/TS prefixes, parts,\n# reaffirmed years, (E)/(J) language codes, 規格群 all-parts, AMD/EXPL/\n# CORR supplements, and the SYMBOL clause.\n\ngrammar PubidJis version \"0.1.0\" edition 2 {\n  dash = (\"-\" / \"ｰ\") as dash\n  space = (\" \" / \"　\")\n  colon = (\":\" / \"：\")\n  type_prefix = (\"TR\" / \"TS\") as type (space / slash)\n  series = %x41-5A as series\n  number = (1*digit) as number\n  part = dash (1*digit) as part\n  parts = (*part) as parts\n  reaffirmed = \"R\" (*\"R\")\n  year = colon (1*digit) as year [reaffirmed_rule]\n  language = (\"(\" / \"（\") (\"E\" / \"J\") as language (\")\" / \"）\")\n  all_parts = ((\"（\" \"規格群\" \"）\") / (\"(\" \"規格群\" \")\")) as all_parts\n  amendment = slash (\"AMENDMENT\" / \"AMD\") as amd_type space (1*digit) as amd_number colon (1*digit) as amd_year ([\"R\" (*\"R\")]) as amd_reaffirmed\n  explanation = slash (\"EXPLANATION\" / \"EXPL\") as expl_type ([space (1*digit) as expl_number])\n  corrigendum = slash (\"CORRIGENDUM\" / \"CORR\") as corr_type space (1*digit) as corr_number colon (1*digit) as corr_year ([\"R\" (*\"R\")]) as corr_reaffirmed\n  supplement = (amendment as amendment) / (explanation as explanation) / (corrigendum as corrigendum)\n  symbol_value_char = %x01-09 / %x0B-10FFFF\n  symbol_clause = space \"SYMBOL\" as symbol_present ([space (1*symbol_value_char) as symbol_value])\n  identifier = [\"JIS\" [(space / slash)]] [type_prefix] [space] series [space] number parts [year] [language] [all_parts] [supplement] [symbol_clause]\n  upper = %x41-5A\n  digit = %x30-39\n  slash = \"/\"\n  reaffirmed_rule = \"R\" (*\"R\") as reaffirmed\n  entry identifier: identifier\n\n  # Typed model bindings: bound captures land on the consumer\n  # builder's fields of the same name; repeated parts collect under\n  # parts[].part.\n  bindings identifier {\n    type -> type (string)\n    series -> series (string)\n    number -> number (string)\n    part -> parts[].part (string)\n    year -> year (string)\n    reaffirmed -> reaffirmed (string)\n    language -> language (string)\n    all_parts -> all_parts (string)\n    amd_type -> amd_type (string)\n    amd_number -> amd_number (string)\n    amd_year -> amd_year (string)\n    amd_reaffirmed -> amd_reaffirmed (string)\n    expl_type -> expl_type (string)\n    expl_number -> expl_number (string)\n    corr_type -> corr_type (string)\n    corr_number -> corr_number (string)\n    corr_year -> corr_year (string)\n    corr_reaffirmed -> corr_reaffirmed (string)\n    symbol_present -> symbol_present (string)\n    symbol_value -> symbol_value (string)\n  }\n\n  \n  test {\n    accept \"JIS B 0001\"\n    accept \"JIS X 0208:1997\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"9fe78cf84df4b1ff87c9c6777a58093a3efef766174e2ec6519d00c297f04333","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:c5f9178c7fdfb6e78636c6249d934237cbc44789efd49819b315767fbc34ff20"}
