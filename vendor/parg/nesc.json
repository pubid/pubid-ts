= 1*digit\n  space = \" \"\n  comma = \",\"\n  dash = \"-\"\n\n  year = 4digit\n  c2_code = \"C2\" as code\n  nesc_full_name = \"National Electrical Safety Code\" / \"National Electric Safety Code\"\n  nesc_abbr = \"NESC\"\n  nesc_name = nesc_full_name / nesc_abbr\n  registered = \"(R)\"\n  edition = (\"Premier Edition\" / \"Second Edition\" / \"Third Edition\" / \"Fourth Edition\" / \"Fifth Edition\" / \"Sixth Edition\" / \"Seventh Edition\" / \"Eighth Edition\" / \"Ninth Edition\" / \"Tenth Edition\" / \"First Edition\") as edition\n  variant = (\"Handbook\" / \"Redline\") as variant\n  month = (\"January\" / \"February\" / \"March\" / \"April\" / \"May\" / \"June\" / \"July\" / \"August\" / \"September\" / \"October\" / \"November\" / \"December\") as month\n\n  c2_standard = (c2_code dash (year) as year [([comma] space)] nesc_full_name [registered] [(space \"(\" nesc_abbr [registered] \")\")])\n  year_first = ((year) as year) space (((nesc_full_name) as full_name [(registered) as name_registered] [(space \"(\" (nesc_abbr) as paren_abbr [(registered) as paren_registered] \")\")]) / (((nesc_abbr) as abbr [(registered) as abbr_registered]))) [(space variant)] [(comma space edition)]\n  name_first = ((nesc_full_name [registered]) comma space c2_code dash (year) as year [(space \"-\" space (variant) as variant)])\n  draft_nesc = ((\"Draft\") as draft space nesc_name [registered] comma space (month) space (year) as year)\n  nesc_identifier = draft_nesc / name_first / c2_standard / year_first\n\n  entry nesc_identifier: nesc_identifier\n\n  test {\n    accept \"C2-2023 National Electrical Safety Code\"\n    accept \"2023 NESC\"\n    accept \"National Electrical Safety Code, C2-2017\"\n    accept \"Draft NESC, January 2016\"\n    reject \"nonsense\"\n  }\n}\n","checksum":"sha256:f3d53ccffb32a4294cc6e4a56ba1367841e83416926149c3ddd6d582b6051c13"}