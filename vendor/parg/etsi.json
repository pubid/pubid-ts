"TBR\" / \"NET\" / \"EN\" / \"ES\" / \"EG\" / \"TS\" / \"GR\" / \"GS\" / \"SR\" / \"TR\") as type\n  # The monorepo's number is a single flat string (\"300 058\", \"298\") —\n  # the inner pieces are structural only, never surfaced as captures.\n  gsm_with_space_number = \"GSM\" space 1*digit dot 1*digit\n  dotted_number = 1*digit dot 1*digit\n  complex_number = 1*alnum_char [(dash 1*alnum_char)] space 1*digit\n  simple_number = 1*digit\n  number = ((\"GSM\" space 1*digit dot 1*digit) / (1*digit dot 1*digit) / (1*alnum_char [(dash 1*alnum_char)] space 1*digit) / (1*digit)) as number\n  minor = space (1*digit) as minor\n  part = dash (1*alnum_char) as part\n  parts = (*part) as parts\n  version = \"V\" (1*version_char) as version\n  edition = \"ed.\" (1*digit) as edition\n  version_or_edition = version / edition\n  date_part = \"(\" (4digit) as year dash (2digit) as month \")\"\n  single_supplement = ((\"/A\" / \"/C\") as supplement_kind (1*digit) as supplement_number)\n  supplements = 1*single_supplement\n  identifier = \"ETSI \" type space number [minor] [parts] [supplements] [(space version_or_edition)] [(space date_part)]\n  alnum_char = %x41-5A / %x61-7A / %x30-39\n  version_char = %x30-39 / %x2E\n  digit = %x30-39\n  dash = \"-\"\n  dot = \".\"\n  space = \" \"\n  entry identifier: identifier\n\n  # Typed model bindings: repeated parts collect under parts[].part and\n  # the supplements pair kind with number by occurrence index.\n  bindings identifier {\n    type -> type (string)\n    number -> number (string)\n    minor -> minor (string)\n    part -> parts[].part (string)\n    version -> version (string)\n    edition -> edition (string)\n    year -> year (string)\n    month -> month (string)\n    supplement_kind -> supplements[].supplement_kind (string)\n    supplement_number -> supplements[].supplement_number (string)\n  }\n\n  \n  test {\n    accept \"ETSI EN 300 175\"\n    accept \"ETSI TR 101 999\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"fcd65f026fe04cb23ccdd6420b18ad5548bc05206afa3cf6e4d2e7e0757e6a1b","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.121","edition":2,"semantics_hash":"sha256:e85bacb7677aeef000d06f85b6dec0b27e1ac4aef512eb74ff60a4c7cbcf645a","checksum":"sha256:fac58c9dfec9e9a0fb0eae0f6b47fd7ad9c87917b1cf37f5ff1e7373c9b73b8f"}
